// =========================================================
// 1. METRICS COLLECTION (Prometheus)
// =========================================================

// --- Host Metrics (CPU, Memory, Disk, Network) ---
prometheus.exporter.unix "host_stats" {
  rootfs_path = "/host/root"
  sysfs_path  = "/host/sys"
  procfs_path = "/host/proc"
}

prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host_stats.targets
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// --- Container Metrics (cAdvisor) ---
prometheus.exporter.cadvisor "container_stats" {
  docker_host = "unix:///var/run/docker.sock"
}

prometheus.scrape "container_metrics" {
  targets    = prometheus.exporter.cadvisor.container_stats.targets
  forward_to = [prometheus.remote_write.default.receiver]
  scrape_interval = "15s"
}

// --- Metrics Destination (Remote Write) ---
prometheus.remote_write "default" {
  endpoint {
    // Note: Append standard remote write path to avoid 405 errors
    url = "__PROMETHEUS_URL__/api/v1/write"
    
    basic_auth {
      username = "__PROMETHEUS_USER__"
      password = "__PROMETHEUS_PASS__"
    }
  }
}

// =========================================================
// 2. LOGS COLLECTION (Loki)
// =========================================================

// --- VM Host System Logs ---
// STEP 1: Discover log files on the host (Refixed component)
local.file_match "host_log_files" {
  path_targets = [
    { __path__ = "/var/log/*.log", job = "system_logs" },
    { __path__ = "/var/log/syslog", job = "syslog" },
    { __path__ = "/var/log/auth.log", job = "auth_logs" },
  ]
}

// STEP 2: Read discovered files and forward to Loki
loki.source.file "host_logs" {
  targets    = local.file_match.host_log_files.targets
  forward_to = [loki.write.default.receiver]
}

// --- Container Logs (Docker) ---
// 1. Automatically discover containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// 1.5. Relabel to expose container name as a label
discovery.relabel "docker_labels" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
}

// 2. Scrape logs from discovered containers
loki.source.docker "container_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.write.default.receiver]
}

// --- Logs Destination (Push API) ---
loki.write "default" {
  endpoint {
    // Note: Append standard push path to avoid 404 errors
    url = "__LOKI_URL__/loki/api/v1/push"
    
    basic_auth {
      username = "__LOKI_USER__"
      password = "__LOKI_PASS__"
    }
  }
}